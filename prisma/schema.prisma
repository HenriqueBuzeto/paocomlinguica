// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMIN
  GERENTE
  OPERADOR
  GARCON
  COZINHA
  ENTREGADOR
  ESTOQUE
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum MovementStatus {
  ACTIVE
  CANCELED
}

enum CashMovementType {
  VENDA
  SANGRIA
  SUPRIMENTO
  DESPESA
  ENTRADA_MANUAL
  SAIDA_MANUAL
  CANCELAMENTO
}

enum SaleStatus {
  COMPLETED
  CANCELED
}

enum PaymentMethodKind {
  CASH
  PIX
  CARD
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  
  roles        UserRole[]
  overrides    UserPermissionOverride[]

  cashRegistersOpened CashRegister[] @relation("cash_register_opened_by")
  cashRegistersClosed CashRegister[] @relation("cash_register_closed_by")
  movements           CashMovement[]
  salesOperated       Sale[] @relation("sale_operator")
  salesCanceled       Sale[] @relation("sale_canceled_by")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id        String           @id @default(cuid())
  name      RoleName         @unique
  users     UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  roles       RolePermission[]
  overrides   UserPermissionOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserPermissionOverride {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  allowed      Boolean

  @@id([userId, permissionId])
  @@index([permissionId])
}

model CashRegister {
  id             String             @id @default(cuid())
  status         CashRegisterStatus @default(OPEN)
  openedAt       DateTime           @default(now())
  openingBalance Decimal            @db.Decimal(12, 2)
  version        Int                @default(0) // Concorrência
  
  closedAt               DateTime?
  openedById             String
  openedBy               User               @relation("cash_register_opened_by", fields: [openedById], references: [id])
  closedById             String?
  closedBy               User?              @relation("cash_register_closed_by", fields: [closedById], references: [id])
  
  // Closing snapshots
  closingBalanceReported Decimal?           @db.Decimal(12, 2)
  expectedBalance        Decimal?           @db.Decimal(12, 2)
  difference             Decimal?           @db.Decimal(12, 2)

  closings       CashClosing[]
  payments       Payment[]
  movements      CashMovement[]
  sales          Sale[]

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model CashMovement {
  id             String           @id @default(cuid())
  cashRegisterId String
  cashRegister   CashRegister     @relation(fields: [cashRegisterId], references: [id])
  type           CashMovementType
  status         MovementStatus   @default(ACTIVE)
  amount         Decimal          @db.Decimal(12, 2)
  description    String?
  saleId         String?
  sale           Sale?            @relation(fields: [saleId], references: [id])
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  canceledAt     DateTime?
}

model CashClosing {
  id             String             @id @default(cuid())
  cashRegisterId String
  cashRegister   CashRegister       @relation(fields: [cashRegisterId], references: [id])
  createdAt      DateTime           @default(now())
  methods        CashClosingMethod[]
}

model CashClosingMethod {
  id            String      @id @default(cuid())
  closingId     String
  closing       CashClosing @relation(fields: [closingId], references: [id])
  methodName    String      // DINHEIRO, PIX, CARD_DEBIT, CARD_CREDIT
  expectedValue Decimal     @db.Decimal(12, 2)
  declaredValue Decimal     @db.Decimal(12, 2)
  difference    Decimal     @db.Decimal(12, 2)
  justification String?
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  price       Decimal     @db.Decimal(12, 2)
  cost        Decimal?    @db.Decimal(12, 2)
  active      Boolean     @default(true)
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  saleItems   SaleItem[]
  recipe      Recipe?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([active])
  @@index([categoryId])
}

model DiningTable {
  id       String       @id @default(cuid())
  number   Int          @unique
  capacity Int?
  section  String?      // ex: "Salão Principal", "Varanda"
  active   Boolean      @default(true)
  sessions TableSession[]
}

enum TableSessionStatus {
  OPEN
  AWAITING_SERVICE
  IN_SERVICE
  AWAITING_KITCHEN
  AWAITING_PAYMENT
  PARTIALLY_PAID
  CLOSING
  CLOSED
  CANCELED
}

model TableSession {
  id         String             @id @default(cuid())
  tableId    String
  table      DiningTable        @relation(fields: [tableId], references: [id])
  status     TableSessionStatus @default(OPEN)
  openedAt   DateTime           @default(now())
  closedAt   DateTime?
  openedById String
  version    Int                @default(0) // Concorrência Otimista
  tabs       Tab[]
}

enum TabStatus {
  OPEN
  IN_SERVICE
  AWAITING_PAYMENT
  PARTIALLY_PAID
  PAID
  CANCELED
  TRANSFERRED
  CLOSED_WITH_ADJUSTMENT
}

model Tab {
  id                String       @id @default(cuid())
  tableSessionId    String?
  tableSession      TableSession? @relation(fields: [tableSessionId], references: [id])
  tabNumber         String       // Número da comanda
  customerName      String?
  status            TabStatus    @default(OPEN)
  version           Int          @default(0) // Concorrência Otimista
  
  // Snapshots Financeiros
  subtotal          Decimal      @db.Decimal(12, 2) @default(0.00)
  addonsTotal       Decimal      @db.Decimal(12, 2) @default(0.00)
  taxTotal          Decimal      @db.Decimal(12, 2) @default(0.00)
  discountTotal     Decimal      @db.Decimal(12, 2) @default(0.00)
  paidAmount        Decimal      @db.Decimal(12, 2) @default(0.00)
  pendingAmount     Decimal      @db.Decimal(12, 2) @default(0.00)
  total             Decimal      @db.Decimal(12, 2) @default(0.00)
  roundingRule      String       @default("HALF_UP")
  feePolicyVersion  String?      // Versão da política aplicada
  
  items             TabItem[]
  payments          Payment[]
  appliedFees       AppliedFee[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model TabItem {
  id                     String             @id @default(cuid())
  tabId                  String
  tab                    Tab                @relation(fields: [tabId], references: [id])
  productId              String
  quantity               Int
  
  // Snapshots no momento da venda
  productNameSnapshot    String
  unitPriceSnapshot      Decimal            @db.Decimal(12, 2)
  variantDescription     String?            // ex: "Ponto bem passado"
  addonsPriceSnapshot    Decimal            @db.Decimal(12, 2) @default(0.00)
  feesSnapshot           Decimal            @db.Decimal(12, 2) @default(0.00)
  total                  Decimal            @db.Decimal(12, 2)
  
  status                 KitchenTicketStatus @default(PENDING)
  notes                  String?
  addons                 TabItemAddon[]
}

enum KitchenTicketStatus {
  PENDING
  IN_PREPARATION
  READY
  DELIVERED
  CANCELED
}

model TabItemAddon {
  id                         String    @id @default(cuid())
  tabItemId                  String
  tabItem                    TabItem   @relation(fields: [tabItemId], references: [id])
  addonId                    String
  addonNameSnapshot          String
  unitPriceSnapshot          Decimal   @db.Decimal(12, 2)
  quantity                   Int
  total                      Decimal   @db.Decimal(12, 2)
  inventoryConsumptionStatus String    @default("PENDING") // PENDING, CONSUMED, REVERTED
}

model FeePolicy {
  id               String              @id @default(cuid())
  name             String              // ex: "Taxa de Garçom"
  type             String              // PERCENTAGE, FIXED
  active           Boolean             @default(true)
  versions         FeePolicyVersion[]
}

model FeePolicyVersion {
  id           String      @id @default(cuid())
  policyId     String
  policy       FeePolicy   @relation(fields: [policyId], references: [id])
  version      Int
  value        Decimal     @db.Decimal(12, 2) // ex: 10.00
  effectiveFrom DateTime   @default(now())
  effectiveTo   DateTime?
}

model AppliedFee {
  id             String    @id @default(cuid())
  tabId          String
  tab            Tab       @relation(fields: [tabId], references: [id])
  name           String
  type           String    // PERCENTAGE, FIXED
  baseAmount     Decimal   @db.Decimal(12, 2)
  rate           Decimal   @db.Decimal(12, 2)
  calculatedValue Decimal  @db.Decimal(12, 2)
  appliedById    String
  removedById    String?
  justification  String?
  createdAt      DateTime  @default(now())
}

model Ingredient {
  id             String            @id @default(cuid())
  name           String            @unique
  unit           String            // KG, UN, L
  balance        InventoryBalance?
  movements      InventoryMovement[]
  recipeUsage    RecipeIngredient[]
}

model InventoryBalance {
  id           String     @id @default(cuid())
  ingredientId String     @unique
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  currentQty   Decimal    @db.Decimal(12, 3)
  updatedAt    DateTime   @updatedAt
  version      Int        @default(0) // Concorrência otimista
}

enum InventoryMovementType {
  CONFIRMED_PRODUCTION
  LOSS
  INPUT_ADJUSTMENT
  OUTPUT_ADJUSTMENT
  CANCEL_REVERSAL
}

model InventoryMovement {
  id             String                @id @default(cuid())
  ingredientId   String
  ingredient     Ingredient            @relation(fields: [ingredientId], references: [id])
  previousQty    Decimal               @db.Decimal(12, 3)
  qtyMoved       Decimal               @db.Decimal(12, 3)
  nextQty        Decimal               @db.Decimal(12, 3)
  type           InventoryMovementType
  reason         String?
  source         String?               // ex: "KITCHEN", "MANUAL"
  tabItemId      String?
  saleId         String?
  operatorId     String
  authorizerId   String?
  idempotencyKey String?               @unique
  createdAt      DateTime              @default(now())
}

model Recipe {
  id          String             @id @default(cuid())
  productId   String             @unique
  product     Product            @relation(fields: [productId], references: [id])
  ingredients RecipeIngredient[]
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id])
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Decimal    @db.Decimal(12, 3)
}

model Payment {
  id             String       @id @default(cuid())
  tabId          String
  tab            Tab          @relation(fields: [tabId], references: [id])
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])
  method         String       // DINHEIRO, PIX, etc.
  amount         Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
}

model IdempotencyKey {
  id             String   @id @default(cuid())
  operationType  String   // ex: "tabs.pay"
  idempotencyKey String   // Enviada pelo cliente
  requestHash    String   // Hash SHA-256 do payload do body
  status         String   // PENDING, COMPLETED, FAILED
  responseStatus Int?
  responseBody   String?  @db.Text
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  @@unique([operationType, idempotencyKey])
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String
  correlationId  String   // ID para agrupar requisições relacionadas
  requestId      String   // ID único da requisição
  terminalId     String?
  sessionId      String?
  ipAddress      String?
  userAgent      String?
  actionCategory String   // SECURITY, FINANCIAL, INVENTORY, CONFIG
  action         String
  entity         String
  entityId       String
  oldValue       String?  @db.Text
  newValue       String?  @db.Text
  justification  String?  @db.Text
  createdAt      DateTime @default(now())
}

model PaymentMethod {
  id        String    @id @default(cuid())
  name      String    @unique
  kind      PaymentMethodKind @default(CASH)
  active    Boolean   @default(true)
  salePayments SalePayment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Sale {
  id             String         @id @default(cuid())
  status         SaleStatus     @default(COMPLETED)
  cashRegisterId String
  cashRegister   CashRegister   @relation(fields: [cashRegisterId], references: [id])
  operatorId     String
  operator       User           @relation("sale_operator", fields: [operatorId], references: [id])
  customerName   String?
  discount       Decimal        @default(0) @db.Decimal(12, 2)
  deliveryFee    Decimal        @default(0) @db.Decimal(12, 2)
  notes          String?
  cashReceived   Decimal?       @db.Decimal(12, 2)
  changeDue      Decimal?       @db.Decimal(12, 2)
  total          Decimal        @db.Decimal(12, 2)
  items          SaleItem[]
  payments       SalePayment[]
  movements      CashMovement[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  canceledAt     DateTime?
  canceledById   String?
  canceledBy     User?          @relation("sale_canceled_by", fields: [canceledById], references: [id])
  canceledReason String?

  @@index([cashRegisterId, createdAt])
  @@index([operatorId, createdAt])
  @@index([status, createdAt])
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
}

model SalePayment {
  id              String        @id @default(cuid())
  saleId          String
  sale            Sale          @relation(fields: [saleId], references: [id])
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([saleId])
  @@index([paymentMethodId])
}
